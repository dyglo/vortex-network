# Copy this file to .env. Only credentials and infrastructure values need editing.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_ENV=sandbox
PESAPAL_SANDBOX_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_PRODUCTION_BASE_URL=https://pay.pesapal.com/v3
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./hotspot_billing.db
MIKROTIK_HOST=
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
# Required only for the temporary GET /api/debug/transactions diagnostic endpoint.
# Send it as the X-Debug-Token request header; leave unset to disable the endpoint.
DEBUG_API_TOKEN=
